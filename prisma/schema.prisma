generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id            String                 @id @default(uuid())
  title         String
  slug          String                 @unique
  content       String
  type          String
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  evolutions    KnowledgeEvolution[]
}

model Decision {
  id         String   @id @default(uuid())
  decisionId Int      @unique
  title      String
  summary    String
  rationale  String?
  status     String   @default("Approved")
  createdAt  DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("planning")
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(uuid())
  question  String
  answer    String
  language  String   @default("en")
  sources   String?
  createdAt DateTime @default(now())
}

model Learning {
  id          String   @id @default(uuid())
  category    String
  title       String
  description String
  source      String
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model Permission {
  id          String    @id @default(uuid())
  action      String
  riskLevel   String    @default("LOW")
  status      String    @default("pending")
  requestedBy String    @default("BEE")
  approvedBy  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  category    String   @default("general")
  severity    String   @default("INFO")
  performedBy String   @default("BEE")
  details     String?
  ip          String?
  hash        String?
  createdAt   DateTime @default(now())
}

model KnowledgeEvolution {
  id           String    @id @default(uuid())
  documentId   String?
  oldContent   String?
  newContent   String
  changeReason String
  confidence   Float     @default(0.5)
  source       String?
  status       String    @default("proposed")
  proposedAt   DateTime  @default(now())
  approvedAt   DateTime?
  approvedBy   String?
  document     Document? @relation(fields: [documentId], references: [id])
}

model RecoveryPoint {
  id          String   @id @default(uuid())
  label       String
  description String?
  snapshot    String
  createdAt   DateTime @default(now())
}

model AIRegistry {
  id                 String   @id @default(uuid())
  modelName          String   @unique
  provider           String
  version            String?
  apiEndpoint        String
  license            String?
  capabilities       String   @default("[]")
  contextWindow      Int?
  vision             Boolean  @default(false)
  audio              Boolean  @default(false)
  coding             Boolean  @default(false)
  reasoning          Boolean  @default(false)
  toolCalling        Boolean  @default(false)
  structuredOutput   Boolean  @default(false)
  benchmarkScore     Float?
  securityLevel      String   @default("MEDIUM")
  costPer1MTokens    String?
  avgSpeedMs         Int?
  reliability        String   @default("MEDIUM")
  rateLimits         String?
  strengths          String   @default("[]")
  weaknesses         String   @default("[]")
  supportedTasks     String   @default("[]")
  pandoraScore       Float?
  projectSuccessRate Float?
  lastEvaluation     DateTime?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ToolRegistry {
  id                String   @id @default(uuid())
  toolName          String   @unique
  version           String?
  provider          String?
  license           String?
  category          String?
  description       String?
  apiSupport        Boolean  @default(false)
  cliSupport        Boolean  @default(false)
  capabilities      String   @default("[]")
  riskLevel         String   @default("LOW")
  isFree            Boolean  @default(true)
  costDescription   String?
  healthStatus      String   @default("unknown")
  integrationStatus String   @default("planned")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DecisionRecord {
  id                String   @id @default(uuid())
  title             String
  context           String
  alternatives      String   @default("[]")
  selectedOption    String?
  riskAnalysis      String?
  costAnalysis      String?
  advantageAnalysis String?
  expectedOutcome   String?
  actualOutcome     String?
  status            String   @default("proposed")
  approvedBy        String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Memory {
  id        String   @id @default(uuid())
  layer     String   @default("L1_SESSION")
  category  String?
  title     String
  content   String
  trust     Float    @default(1.0)
  scope     String   @default("global")
  version   Int      @default(1)
  status    String   @default("active")
  source    String?
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id          String       @id @default(uuid())
  name        String
  type        String
  url         String?
  filePath    String?
  license     String?
  isFree      Boolean      @default(true)
  costDetail  String?
  source      String?
  projectId   String?
  tags        String       @default("[]")
  gameProject GameProject? @relation(fields: [projectId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GameProject {
  id          String   @id @default(uuid())
  title       String
  description String?
  genre       String?
  engine      String?
  artStyle    String?
  platform    String?
  status      String   @default("planning")
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model ChatRoom {
  id          String         @id @default(uuid())
  name        String
  type        String         @default("general")
  projectId   String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    Message[]
}

model Message {
  id          String    @id @default(uuid())
  roomId      String
  role        String    @default("user")
  content     String
  createdAt   DateTime  @default(now())
  room        ChatRoom  @relation(fields: [roomId], references: [id])
}
model CrossDepartmentInsight {
  id              String   @id @default(uuid())
  sourceDept      String
  targetDept      String
  title           String
  description     String
  relevanceScore  Float    @default(0.5)
  status          String   @default("proposed")
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
}
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model GameScore {
  id        String   @id @default(uuid())
  username  String
  roomId    String
  score     Int
  metadata  String?
  createdAt DateTime @default(now())
}