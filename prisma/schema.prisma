generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       String
  type          String
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Decision {
  id         String   @id @default(uuid())
  decisionId Int      @unique
  title      String
  summary    String
  rationale  String?
  status     String   @default("Approved")
  createdAt  DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("planning")
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Conversation {
  id        String   @id @default(uuid())
  question  String
  answer    String
  language  String   @default("en")
  sources   String?
  createdAt DateTime @default(now())
}
model Learning {
  id          String   @id @default(uuid())
  category    String   // "correction", "improvement", "error", "insight"
  title       String
  description String
  source      String   // "user_feedback", "self_correction", "pattern_analysis"
  status      String   @default("active") // "active", "applied", "dismissed"
  createdAt   DateTime @default(now())
}
model Permission {
  id          String   @id @default(uuid())
  action      String
  riskLevel   String   @default("LOW")
  status      String   @default("pending")
  requestedBy String   @default("BEE")
  approvedBy  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  category  String   @default("general")
  severity  String   @default("INFO")
  performedBy String @default("BEE")
  details   String?
  ip        String?
  hash      String?
  createdAt DateTime @default(now())
}
model AIRegistry {
  id              String   @id @default(uuid())
  modelName       String   @unique
  provider        String
  version         String?
  apiEndpoint     String
  license         String?
  capabilities    String   @default("[]")
  contextWindow   Int?
  vision          Boolean  @default(false)
  audio           Boolean  @default(false)
  coding          Boolean  @default(false)
  reasoning       Boolean  @default(false)
  toolCalling     Boolean  @default(false)
  structuredOutput Boolean @default(false)
  benchmarkScore  Float?
  securityLevel   String   @default("MEDIUM")
  costPer1MTokens String?
  avgSpeedMs      Int?
  reliability     String   @default("MEDIUM")
  rateLimits      String?
  strengths       String   @default("[]")
  weaknesses      String   @default("[]")
  supportedTasks  String   @default("[]")
  pandoraScore    Float?
  projectSuccessRate Float?
  lastEvaluation  DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
